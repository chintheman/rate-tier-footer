+# ---------------------------------------------------------------------------
+# rate_tier (DeepSeek peak/off-peak billing awareness)
+# ---------------------------------------------------------------------------
+
+def test_rate_tier_deepseek_built_in_windows():
+    peak = datetime(2026, 1, 1, 2, tzinfo=timezone.utc)      # 02:00 UTC -> peak
+    off = datetime(2026, 1, 1, 13, tzinfo=timezone.utc)      # 13:00 UTC -> off-peak
+    assert rate_tier_for_model("deepseek-v4-flash", now=peak) == "peak"
+    assert rate_tier_for_model("deepseek-v4-flash", now=off) == "off-peak"
+    assert rate_tier_for_model("deepseek/deepseek-v4-pro", now=peak) == "peak"
+
+
+def test_rate_tier_skips_non_matching_model():
+    assert rate_tier_for_model("claude-sonnet-4-6", now=datetime(2026, 1, 1, 2, tzinfo=timezone.utc)) is None
+
+
+def test_rate_tier_beijing_weekend_is_all_day_off_peak():
+    sat = datetime(2026, 8, 22, 2, tzinfo=timezone.utc)      # Beijing Sat 10:00
+    mon = datetime(2026, 8, 24, 2, tzinfo=timezone.utc)      # Beijing Mon 10:00
+    assert rate_tier_for_model("deepseek-v4-flash", now=sat) == "off-peak"
+    assert rate_tier_for_model("deepseek-v4-flash", now=mon) == "peak"
+
+
+def test_rate_tier_window_wraps_midnight():
+    nightowl = {"nightowl": {"tz": "UTC", "peak": [[22, 2]]}}
+    assert rate_tier_for_model(
+        "nightowl-1", nightowl, now=datetime(2026, 1, 1, 23, tzinfo=timezone.utc)) == "peak"
+
+
+def test_rate_tier_longest_matcher_key_wins():
+    win = {"deepseek": {"tz": "UTC", "peak": [[1, 4], [6, 10]]},
+           "deepseek-v4-flash": {"tz": "UTC", "peak": [[20, 23]]}}
+    assert rate_tier_for_model(
+        "deepseek-v4-flash", win, now=datetime(2026, 1, 1, 21, tzinfo=timezone.utc)) == "peak"
+
+
+def test_rate_tier_custom_timezone_window():
+    cfg = {"deepseek": {"tz": "Asia/Singapore", "peak": [[9, 12], [14, 18]]}}
+    assert rate_tier_for_model(
