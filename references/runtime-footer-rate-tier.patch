 from __future__ import annotations
 
+import datetime as _dt
 import os
 from typing import Any, Iterable, Optional
 
+try:
+    from zoneinfo import ZoneInfo as _ZoneInfo
+except ImportError:  # pragma: no cover - py<3.9 fallback
